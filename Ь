<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Мой Мессенджер</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 0; background: #f0f2f5; display: flex; justify-content: center; align-items: center; height: 100vh; }
        .chat-container { width: 100%; max-width: 400px; background: white; border-radius: 10px; box-shadow: 0 0 10px rgba(0,0,0,0.1); overflow: hidden; display: flex; flex-direction: column; height: 90vh; }
        .header { background: #0084ff; color: white; padding: 15px; text-align: center; font-weight: bold; }
        .messages { flex: 1; padding: 15px; overflow-y: auto; background: #e5e5e5; }
        .message { margin: 10px 0; padding: 10px 15px; border-radius: 20px; max-width: 80%; }
        .my-msg { background: #0084ff; color: white; align-self: flex-end; margin-left: auto; border-bottom-right-radius: 5px; }
        .other-msg { background: white; align-self: flex-start; border-bottom-left-radius: 5px; }
        .input-area { padding: 10px; background: white; display: flex; }
        input { flex: 1; padding: 12px; border: 1px solid #ddd; border-radius: 25px; margin-right: 10px; }
        button { background: #0084ff; color: white; border: none; padding: 12px 20px; border-radius: 25px; cursor: pointer; }
        .message-time { font-size: 10px; opacity: 0.7; margin-top: 5px; }
    </style>
</head>
<body>
    <div class="chat-container">
        <div class="header">Мой Мессенджер</div>
        <div class="messages" id="messages"></div>
        <div class="input-area">
            <input type="text" id="messageInput" placeholder="Напиши сообщение..." onkeypress="if(event.key === 'Enter') sendMessage()">
            <button onclick="sendMessage()">Отправить</button>
        </div>
    </div>

    <script>
        const messagesDiv = document.getElementById('messages');
        const input = document.getElementById('messageInput');

        function addMessage(text, isMine) {
            const msg = document.createElement('div');
            msg.className = `message ${isMine ? 'my-msg' : 'other-msg'}`;
            const time = new Date().toLocaleTimeString([], {hour: '2-digit', minute: '2-digit'});
            msg.innerHTML = `\( {text}<div class="message-time"> \){time}</div>`;
            messagesDiv.appendChild(msg);
            messagesDiv.scrollTop = messagesDiv.scrollHeight;
        }

        function sendMessage() {
            const text = input.value.trim();
            if (!text) return;
            addMessage(text, true);  // твоё сообщение
            input.value = '';

            // Симуляция ответа "собеседника" через 1 секунду
            setTimeout(() => {
                const replies = ["Круто!", "Расскажи подробнее", "Согласен 😊", "Хаха, точно!", "Как дела?"];
                addMessage(replies[Math.floor(Math.random() * replies.length)], false);
            }, 800);
        }

        // Пример начальных сообщений
        window.onload = () => {
            addMessage("Привет! Это тестовый мессенджер.", false);
        };
    </script>
</body>
</html>
